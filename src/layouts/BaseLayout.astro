---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TrendToggle from '../components/TrendToggle.astro';
import SeoHead from '../components/SeoHead.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  headerTitle?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = `Hi 👋 | ${SITE.title}`,
  headerTitle,
  description = SITE.description,
  path = '/',
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const storedTheme = window.localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const themePreference =
          storedTheme === 'dark' || storedTheme === 'light' || storedTheme === 'system'
            ? storedTheme
            : prefersDark
              ? 'dark'
              : 'light';
        const colorMode =
          themePreference === 'system' ? (prefersDark ? 'dark' : 'light') : themePreference;
        const storedEra = window.localStorage.getItem('blog-design-era');
        const designEra = storedEra || 'default';

        root.dataset.colorMode = colorMode;
        root.dataset.themePreference = themePreference;
        root.dataset.trend = designEra;
      })();
    </script>
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
  </head>
  <body>
    <SiteHeader title={headerTitle} />
    <TrendToggle />
    <div class="site-content">
      <main class="h-sc">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </body>
</html>
