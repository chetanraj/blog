---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const { title = 'Hi 👋 | Blog by Chetan Raj' } = Astro.props;
import * as stylex from '@stylexjs/stylex';
import { legacyHeaderStyles } from '../styles/legacyHeader.stylex';
---

<header {...stylex.props(legacyHeaderStyles.root)}>
  <nav {...stylex.props(legacyHeaderStyles.nav)}>
    <a href={base} {...stylex.props(legacyHeaderStyles.title)}>
      {title}
    </a>
    <div {...stylex.props(legacyHeaderStyles.links)}>
      <a href={base} {...stylex.props(legacyHeaderStyles.link)}>Home</a>
      <a href={`${base}posts/`} {...stylex.props(legacyHeaderStyles.link)}>Posts</a>
    </div>
  </nav>
</header>
