---
import { mediterraneanScene } from '../utils/mediterranean-scene';
const scene = mediterraneanScene();
---
<div class="terrace-scene" aria-hidden="true">
  <svg viewBox="0 0 1000 380" preserveAspectRatio="xMidYMax slice" focusable="false" xmlns="http://www.w3.org/2000/svg">
    {(['landscape', 'clouds', 'glints', 'boat', 'architecture'] as const).map(layer => (
      <g class={`terrace-${layer}`}>
        {scene[layer].map(run => <text x={run.x} y={run.y} textLength={run.text.length * 5} lengthAdjust="spacingAndGlyphs" fill={`var(--scene-${run.ink})`}>{run.text}</text>)}
      </g>
    ))}
  </svg>
</div>
<style>
  .terrace-scene { width:100%; height:clamp(280px,38vw,540px); overflow:hidden; --scene-sea:#26578c; --scene-deep:#183b62; --scene-foam:#799ba9; --scene-mountain:#6b8796; --scene-plaster:#ad9a77; --scene-shade:#85795f; --scene-roof:#a64f35; --scene-tile:#c27d51; --scene-teal:#246966; --scene-leaf:#3f6955; }
  svg { display:block; width:100%; height:100%; }
  text { font-family:'Geist Mono',monospace; font-size:6px; font-weight:500; }
  .terrace-clouds { animation:cloud-drift 28s ease-in-out infinite alternate; }
  .terrace-boat { animation:boat-drift 18s ease-in-out infinite alternate; transform-origin:720px 225px; }
  .terrace-glints { animation:sea-glint 7s ease-in-out infinite alternate; }
  :global(.site-footer:not([data-scene-running='true'])) g { animation-play-state:paused; }
  :global(html[data-color-mode='dark']) .terrace-scene { --scene-sea:#527b9e; --scene-deep:#324f6c; --scene-foam:#8ca7b5; --scene-mountain:#3b536c; --scene-plaster:#9eacb5; --scene-shade:#687e91; --scene-roof:#b1826a; --scene-tile:#d0a285; --scene-teal:#679b9d; --scene-leaf:#658d88; }
  @keyframes cloud-drift { to { transform:translateX(10px); } }
  @keyframes boat-drift { to { transform:translate(7px,1px) rotate(.6deg); } }
  @keyframes sea-glint { from { opacity:.35; } to { opacity:.8; } }
  @media (max-width:600px) { .terrace-scene { height:clamp(190px,54vw,260px); } }
  @media (prefers-reduced-motion:reduce) { g { animation:none!important; } }
</style>
