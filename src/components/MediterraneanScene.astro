---
const base = import.meta.env.BASE_URL;
---
<div class="santorini-scene" aria-hidden="true">
  <img class="santorini-light" src={`${base}art/santorini-light.svg`} width="1000" height="625" alt="" loading="lazy" decoding="async" />
  <img class="santorini-dark" src={`${base}art/santorini-dark.svg`} width="1000" height="625" alt="" loading="lazy" decoding="async" />
</div>
<style>
  .santorini-scene { width:100%; max-width:1120px; margin:auto; overflow:hidden; }
  img { display:block; width:100%; height:auto; }
  .santorini-dark { display:none; }
  :global(html[data-color-mode='dark']) .santorini-light { display:none; }
  :global(html[data-color-mode='dark']) .santorini-dark { display:block; }
</style>
