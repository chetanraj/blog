---
import type { CollectionEntry } from 'astro:content';
import { BlogIcon } from './icons/BlogIcon';
import { ArrowLeft, ArrowRight } from '../icons';

interface Props {
  previous?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
  base: string;
}

const { previous, next, base } = Astro.props;
---

{
  (previous || next) && (
    <nav class="post-pager" aria-label="Previous and next posts">
      {previous ? (
        <a
          href={`${base}posts/${previous.slug}/`}
          class="post-pager-link post-pager-prev"
          aria-label={`Previous: ${previous.data.title}`}
        >
          <BlogIcon icon={ArrowLeft} size="md" />
          <span class="post-pager-title">{previous.data.title}</span>
        </a>
      ) : (
        <span class="post-pager-spacer"></span>
      )}
      {next ? (
        <a
          href={`${base}posts/${next.slug}/`}
          class="post-pager-link post-pager-next"
          aria-label={`Next: ${next.data.title}`}
        >
          <span class="post-pager-title">{next.data.title}</span>
          <BlogIcon icon={ArrowRight} size="md" />
        </a>
      ) : (
        <span class="post-pager-spacer"></span>
      )}
    </nav>
  )
}
