---
import { BlogIcon } from './icons/BlogIcon';
import { Github, Instagram, X } from '../icons';
import MediterraneanScene from './MediterraneanScene.astro';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer site-chrome">
  <div class="terrace-heading">
    <div class="terrace-intro">
      <p class="terrace-kicker">A GOOD PLACE TO PAUSE</p>
      <h2>Until the next idea.</h2>
      <p class="site-footer-copy site-footer-signoff">Built with curiosity. Written from experience.</p>
    </div>
    <nav class="terrace-links" aria-label="Footer">
      <a href={base}>Writing</a>
      <a href={`${base}about/`}>About</a>
      <a href={`${base}rss.xml`}>RSS feed</a>
    </nav>
    <div class="site-footer-social-links">
      <a class="site-footer-icon-link" href="https://x.com/chetan_raj" aria-label="X"><BlogIcon icon={X} /></a>
      <a class="site-footer-icon-link" href="https://github.com/chetanraj" aria-label="GitHub"><BlogIcon icon={Github} /></a>
      <a class="site-footer-icon-link" href="https://www.instagram.com/thecjstream/" aria-label="Instagram"><BlogIcon icon={Instagram} /></a>
    </div>
  </div>
  <div class="terrace-artwork">
    <MediterraneanScene />
  </div>
  <div class="terrace-colophon">
    <p class="site-footer-copy">&copy; 2016-present <a href="https://chetanraj.dev" class="site-footer-brand-inline">Chetan Raj</a>. All Rights Reserved.</p>
    <span class="terrace-location">Santorini, in characters. <a href="https://unsplash.com/photos/white-and-blue-dome-building-OJScR4tDRyc">Photo by Florian Wehde</a>.</span>
  </div>
</footer>
<style>
  .site-footer { background:var(--color-bg)!important; color:var(--color-content)!important; border-top:1px solid var(--trend-border); }
  .terrace-heading,.terrace-colophon { width:100%; max-width:var(--studio-container); margin-inline:auto; padding-inline:var(--studio-gutter); }
  .terrace-heading { display:grid; grid-template-columns:minmax(0,1fr) auto auto; align-items:start; gap:3.5rem; padding-top:3.5rem; padding-bottom:1rem; }
  .terrace-kicker { font-family:var(--studio-tag-font); font-size:.65rem; letter-spacing:.12em; color:var(--color-secondary); margin:0 0 1rem; }
  h2 { font-family:var(--studio-title-font); font-size:clamp(2rem,3.8vw,3.25rem); font-weight:400; font-synthesis:none; line-height:1.2; margin:0 0 1rem; letter-spacing:-.025em; }
  .site-footer-copy { font-size:.75rem; line-height:1.7; color:var(--color-secondary); opacity:1; }
  .terrace-links { display:flex; flex-direction:column; align-items:flex-start; margin-top:.25rem; }
  .site-footer a:link,.site-footer a:visited { color:inherit; }
  .terrace-links a { font-size:.8125rem; min-height:36px; display:flex; align-items:center; text-decoration:none; }
  .terrace-links a:hover { text-decoration:underline; text-underline-offset:5px; }
  .site-footer-social-links { display:flex; gap:4px; margin-top:.2rem; }
  .site-footer-icon-link { color:var(--color-content); }
  .site-footer a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  .terrace-artwork { margin-top:2rem; background:#f3eddf; }
  :global(html[data-color-mode='dark']) .terrace-artwork { background:#142033; }
  .terrace-colophon { display:flex; justify-content:space-between; gap:1rem; padding-block:1.5rem; border-top:1px solid var(--trend-border); }
  .terrace-location { color:var(--color-secondary); font: .65rem/1.8 var(--studio-tag-font); }
  @media(max-width:700px) {
    .terrace-heading { grid-template-columns:1fr auto; gap:1.5rem; padding-top:2.5rem; }
    .terrace-intro { grid-column:1/-1; }
    .terrace-links { flex-direction:row; gap:1.25rem; }
    .terrace-links a { min-height:44px; }
    .site-footer-social-links { gap:0; }
    .terrace-artwork { margin-top:0; }
    .terrace-colophon { flex-direction:column; gap:.5rem; }
  }
  @media(max-width:370px) { .terrace-heading { grid-template-columns:1fr; gap:.5rem; } .terrace-links { gap:1.25rem; } }
</style>
