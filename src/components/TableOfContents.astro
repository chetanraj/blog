---
import { Link } from '@capper-ui/react';
import { BlogIcon } from './icons/BlogIcon';
import { ChevronDown } from '../icons';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
  maxDepth?: number;
  variant?: 'inline' | 'sticky';
}

const { headings, maxDepth = 2, variant = 'inline' } = Astro.props;

const items = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= maxDepth
);
---

{
  items.length > 0 && (
    <nav
      class:list={['post-toc', variant === 'sticky' && 'post-toc--sticky']}
      aria-label="Table of contents"
    >
      <details class="post-toc-details" open>
        <summary class="post-toc-summary">
          <span class="post-toc-title">On this page</span>
          <span class="post-toc-toggle" aria-hidden="true">
            <BlogIcon icon={ChevronDown} size="sm" />
          </span>
        </summary>
        <ol class="post-toc-list">
          {items.map((heading) => (
            <li class={`post-toc-item post-toc-item--depth-${heading.depth}`}>
              <Link href={`#${heading.slug}`} size="sm" className="post-toc-link">
                {heading.text}
              </Link>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}
