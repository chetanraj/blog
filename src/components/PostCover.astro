---
import { Image } from 'astro:assets';
import dreamblur1 from '../assets/post-covers/dreamblur-1.webp';
import dreamblur2 from '../assets/post-covers/dreamblur-2.webp';
import dreamblur3 from '../assets/post-covers/dreamblur-3.webp';
import dreamblur4 from '../assets/post-covers/dreamblur-4.webp';
import { getPostCoverIndex } from '../utils/post-cover';

interface Props {
  postId: string;
}
const { postId } = Astro.props;
const covers = [dreamblur1, dreamblur2, dreamblur3, dreamblur4];
const cover = covers[getPostCoverIndex(postId, covers.length)];
---

<div class="post-cover" aria-hidden="true">
  <Image
    src={cover}
    alt=""
    widths={[480, 800, 1200, 1600]}
    sizes="(max-width: 640px) calc(100vw - 2.5rem), (max-width: 1152px) 90vw, 1056px"
    format="webp"
    quality={80}
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .post-cover {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    width: 100%;
    aspect-ratio: 4 / 1;
    min-height: 9rem;
    max-height: 16rem;
    overflow: hidden;
    border-radius: .5rem;
    background: var(--trend-surface);
  }
  .post-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
