---
import { Image } from 'astro:assets';
import { getPostCover } from '../utils/post-cover-assets';
interface Props { postId: string; }
const { postId } = Astro.props;
const cover = getPostCover(postId);
---

<div class="post-cover" aria-hidden="true">
  <Image
    src={cover}
    alt=""
    widths={[480, 800, 1200, 1600]}
    sizes="(max-width: 640px) calc(100vw - 2.5rem), (max-width: 1152px) 90vw, 1056px"
    format="webp"
    quality={80}
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .post-cover {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    width: 100%;
    aspect-ratio: 4 / 1;
    min-height: 9rem;
    max-height: 16rem;
    overflow: hidden;
    border-radius: .5rem;
    background: var(--trend-surface);
  }
  .post-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
