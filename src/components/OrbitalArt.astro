<orbital-illustration class="orbital-art" aria-hidden="true">
  <svg viewBox="0 0 300 300" fill="none"><defs><pattern id="orbit-grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" stroke="#25384e" stroke-width="1"/></pattern></defs><path fill="url(#orbit-grid)" stroke="#25384e" d="M1 1h298v298H1z"/><g class="orbital-rings"><ellipse cx="150" cy="150" rx="135" ry="66" transform="rotate(-38 150 150)" stroke="#6ed5dc"/><ellipse cx="150" cy="150" rx="135" ry="66" transform="rotate(58 150 150)" stroke="#4c94a2"/><circle cx="255" cy="82" r="6" fill="#d5ee84"/><circle cx="47" cy="221" r="3" fill="#6ed5dc"/></g><path fill="#101d32" stroke="#3b4e62" d="M90 82h120v136H90z"/><text x="150" y="168" text-anchor="middle" fill="#d5ee84" font-family="monospace" font-size="58">{`{ }`}</text></svg>
</orbital-illustration>

<script>
  import { gsap } from 'gsap';

  class OrbitalIllustration extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.cleanup) return;
      const rings = this.querySelector<SVGGElement>('.orbital-rings');
      if (!rings) return;
      const media = gsap.matchMedia();
      media.add('(prefers-reduced-motion: no-preference)', () => {
        // Only the ring group turns; the grid and code brackets stay still.
        const orbit = gsap.to(rings, {
          rotation: 360,
          svgOrigin: '150 150',
          duration: 48,
          ease: 'none',
          repeat: -1,
          paused: true,
        });
        let visible = false;
        const sync = () => orbit.paused(!visible || document.hidden);
        const observer = new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          sync();
        });
        observer.observe(this);
        document.addEventListener('visibilitychange', sync);
        return () => {
          observer.disconnect();
          document.removeEventListener('visibilitychange', sync);
        };
      });
      this.cleanup = () => media.revert();
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get('orbital-illustration')) {
    customElements.define('orbital-illustration', OrbitalIllustration);
  }
</script>
