---
import { SITE } from '../site.config';
---

<aside class="author-blurb" aria-label="About the author">
  <p class="author-blurb-kicker">Written by</p>
  <p class="author-blurb-name">
    <a href={SITE.author.url}>{SITE.author.name}</a>
  </p>
  <p class="author-blurb-bio">{SITE.author.bio}</p>
  <div class="author-blurb-links">
    <a href={`https://twitter.com/${SITE.author.twitter}`} rel="noopener noreferrer" target="_blank">
      Twitter
    </a>
    <a href={`https://github.com/${SITE.author.github}`} rel="noopener noreferrer" target="_blank">
      GitHub
    </a>
    <a
      href={`https://www.instagram.com/${SITE.author.instagram}/`}
      rel="noopener noreferrer"
      target="_blank"
    >
      Instagram
    </a>
    <a href={`${import.meta.env.BASE_URL}about/`}>About</a>
  </div>
</aside>
