---
import { BlogIcon } from './icons/BlogIcon';
import { ArrowLeft, Droplet, Monitor, Moon, Rss, Search, Sun } from '../icons';
import * as stylex from '@stylexjs/stylex';
import { headerStyles } from '../styles/header.stylex';

const { title } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const headerTitle = title ? String(title) : 'Blog by Chetan Raj';
---

<header class:list={['site-header', 'site-chrome', stylex.props(headerStyles.root).className]}>
  <div class:list={['hero-text', stylex.props(headerStyles.hero).className]}>
    <div {...stylex.props(headerStyles.title)}>
      {headerTitle}
    </div>
    {
      !title && (
        <div {...stylex.props(headerStyles.tagline)}>
          Web Designer & Developer,<wbr />{' '}
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.instagram.com/javascriptessentials/"
            {...stylex.props(headerStyles.taglineLink)}
          >
            Tech Instagrammer
          </a>
          , Music, Movies, Gadgets,<wbr /> Iron Man & Batman lover.
        </div>
      )
    }
  </div>

  <span class:list={['home', stylex.props(headerStyles.homeLink).className]}>
    {
      !title ? (
        <a
          {...stylex.props(headerStyles.homeAnchor)}
          href="https://chetanraj.dev"
        >
          HOME
        </a>
      ) : (
        <a {...stylex.props(headerStyles.homeAnchor)} href={base} aria-label="Back to blog home">
          <BlogIcon icon={ArrowLeft} label="Back to blog home" />
        </a>
      )
    }
  </span>

  <div id="themeToggle" class:list={['site-header-actions', 'light']}>
    <a
      class="site-header-action site-header-action--rss"
      href={`${base}rss.xml`}
      title="RSS"
      aria-label="RSS feed"
    >
      <BlogIcon icon={Rss} />
    </a>
    <a
      class="site-header-action"
      href={`${base}search/`}
      title="Search"
      aria-label="Search posts"
    >
      <BlogIcon icon={Search} />
    </a>
    <label
      class="site-header-action site-header-action--accent"
      title="Accent color"
    >
      <span class="site-header-accent-icon" aria-hidden="true">
        <BlogIcon icon={Droplet} />
      </span>
      <input
        class="site-header-accent-input"
        type="color"
        id="accentColorInput"
        value="#0f4c81"
        aria-label="Choose accent color"
      />
    </label>
    <button
      class="site-header-action theme-icon-button"
      title="Theme"
      type="button"
      id="themeButton"
      aria-label="Toggle theme"
    >
      <span class="theme-icon" data-theme-icon="light" hidden>
        <BlogIcon icon={Moon} />
      </span>
      <span class="theme-icon" data-theme-icon="dark" hidden>
        <BlogIcon icon={Sun} />
      </span>
      <span class="theme-icon" data-theme-icon="system" hidden>
        <BlogIcon icon={Monitor} />
      </span>
    </button>
  </div>

  <div class="bg"></div>
</header>

<script is:inline>
  const root = document.documentElement;
  const body = document.body;
  const wrap = document.getElementById('themeToggle');
  const btn = document.getElementById('themeButton');
  const accentInput = document.getElementById('accentColorInput');
  const ACCENT_STORAGE_KEY = 'blog-accent-color';
  const DEFAULT_ACCENT = '#0f4c81';
  const colorSchemeQuery = window.matchMedia('(prefers-color-scheme: dark)');

  function normalizeAccent(value) {
    if (typeof value !== 'string') return null;
    const hex = value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(hex)) return hex.toLowerCase();
    if (/^#[0-9a-fA-F]{3}$/.test(hex)) {
      return (
        '#' +
        hex
          .slice(1)
          .split('')
          .map((c) => c + c)
          .join('')
      ).toLowerCase();
    }
    return null;
  }

  function applyAccent(color) {
    const next = normalizeAccent(color);
    if (!next) return;
    root.style.setProperty('--color-accent', next);
    root.style.setProperty('--on-surface-accent', next);
    if (accentInput) accentInput.value = next;
    window.localStorage.setItem(ACCENT_STORAGE_KEY, next);
  }

  function syncAccentInput() {
    if (!accentInput) return;
    const stored = normalizeAccent(window.localStorage.getItem(ACCENT_STORAGE_KEY));
    if (stored) {
      accentInput.value = stored;
      return;
    }
    const computed = getComputedStyle(root).getPropertyValue('--color-accent').trim();
    accentInput.value = normalizeAccent(computed) || DEFAULT_ACCENT;
  }

  const storedAccent = normalizeAccent(window.localStorage.getItem(ACCENT_STORAGE_KEY));
  if (storedAccent) applyAccent(storedAccent);
  else syncAccentInput();

  accentInput?.addEventListener('input', (event) => {
    applyAccent(event.target.value);
  });
  accentInput?.addEventListener('focus', syncAccentInput);

  function getInitialTheme() {
    const persisted = window.localStorage.getItem('theme');
    if (persisted === 'dark' || persisted === 'light' || persisted === 'system')
      return persisted;
    return colorSchemeQuery.matches ? 'dark' : 'light';
  }

  function playSound() {
    const audioContext = new (
      window.AudioContext || window.webkitAudioContext
    )();
    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();

    oscillator.connect(gainNode);
    gainNode.connect(audioContext.destination);

    oscillator.frequency.value = 800;
    oscillator.type = 'sine';

    gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(
      0.01,
      audioContext.currentTime + 0.1
    );

    oscillator.start(audioContext.currentTime);
    oscillator.stop(audioContext.currentTime + 0.1);
  }

  function showThemeIcon(preference) {
    document.querySelectorAll('[data-theme-icon]').forEach((el) => {
      const match = el.getAttribute('data-theme-icon') === preference;
      if (match) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });

    const labels = {
      light: 'Switch to dark theme',
      dark: 'Switch to system theme',
      system: 'Switch to light theme',
    };
    if (btn) btn.setAttribute('aria-label', labels[preference] || 'Toggle theme');
  }

  function setTheme(next) {
    const themeToApply =
      next === 'system' ? (colorSchemeQuery.matches ? 'dark' : 'light') : next;

    root.dataset.colorMode = themeToApply;
    root.dataset.themePreference = next;
    body.classList.remove('dark', 'light');
    body.classList.add(themeToApply);
    wrap?.classList.remove('dark', 'light');
    wrap?.classList.add(themeToApply);

    showThemeIcon(next);
    window.localStorage.setItem('theme', next);
    playSound();
  }

  const initial = typeof window !== 'undefined' ? getInitialTheme() : 'light';
  const stored = typeof window !== 'undefined' ? window.localStorage.getItem('theme') : null;
  const initialPreference =
    stored === 'dark' || stored === 'light' || stored === 'system'
      ? stored
      : initial === 'dark'
        ? 'dark'
        : 'light';

  setTheme(initialPreference);

  btn?.addEventListener('click', () => {
    const current = window.localStorage.getItem('theme') || initialPreference;
    const next =
      current === 'system' ? 'light' : current === 'light' ? 'dark' : 'system';
    setTheme(next);
  });

  colorSchemeQuery.addEventListener('change', () => {
    if (window.localStorage.getItem('theme') === 'system') {
      setTheme('system');
    }
  });
</script>
