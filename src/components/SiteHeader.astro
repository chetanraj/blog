---
import { BlogIcon } from './icons/BlogIcon';
import { Monitor, Moon, Sun } from '../icons';
import * as stylex from '@stylexjs/stylex';
import { headerStyles } from '../styles/header.stylex';
import OrbitalArt from './OrbitalArt.astro';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
---
<header class:list={['studio-header', stylex.props(headerStyles.root).className, { 'studio-header--home': !title }]} id="top">
  <div class="studio-shell">
    <nav class:list={["studio-nav", stylex.props(headerStyles.nav).className]} aria-label="Main navigation">
      <a class="studio-brand" href={base}><span class="brand-mark">cr.</span><span>Chetan Raj</span></a>
      <div class="studio-links">
        <a href={base} aria-current={currentPath === base ? 'page' : undefined}>Writing</a>
        <a href={`${base}about/`} aria-current={currentPath.includes('/about') ? 'page' : undefined}>About</a>
        <a href={`${base}search/`} aria-label="Search posts">Search</a>
        <a href={`${base}rss.xml`} class="nav-rss">RSS ↗</a>
        <div id="themeToggle"><button class="studio-theme" type="button" id="themeButton" aria-label="Toggle theme"><span data-theme-icon="light" hidden><BlogIcon icon={Moon} /></span><span data-theme-icon="dark" hidden><BlogIcon icon={Sun} /></span><span data-theme-icon="system" hidden><BlogIcon icon={Monitor} /></span></button></div>
      </div>
    </nav>
    <div class:list={["studio-hero", stylex.props(headerStyles.hero).className]}>
      <div class="studio-intro">
        <p class="eyebrow">{title ? 'THE NOTEBOOK / CHETAN RAJ' : 'FRONTEND / TOOLS / THINGS LEARNED'}</p>
        <h1 {...stylex.props(headerStyles.title)}>{title || <>Notes from<br />the build.</>}</h1>
        {!title && <><div class="hero-rule"></div><p class:list={["studio-description", stylex.props(headerStyles.tagline).className]}>I’m Chetan. I build for the web, question the defaults, and write about what I figure out.</p><a class="hero-explore" href="#writing">EXPLORE THE WRITING ↓</a></>}
        {title && <a class="hero-back" href={base}>← All notes</a>}
      </div>
      <OrbitalArt />
    </div>
  </div>
</header>
<script is:inline>
  const root = document.documentElement;
  const body = document.body;
  const wrap = document.getElementById('themeToggle');
  const btn = document.getElementById('themeButton');
  const colorSchemeQuery = window.matchMedia('(prefers-color-scheme: dark)');

  function getInitialTheme() {
    const persisted = window.localStorage.getItem('theme');
    if (persisted === 'dark' || persisted === 'light' || persisted === 'system')
      return persisted;
    return colorSchemeQuery.matches ? 'dark' : 'light';
  }

  function showThemeIcon(preference) {
    document.querySelectorAll('[data-theme-icon]').forEach((el) => {
      const match = el.getAttribute('data-theme-icon') === preference;
      if (match) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });

    const labels = {
      light: 'Switch to dark theme',
      dark: 'Switch to system theme',
      system: 'Switch to light theme',
    };
    if (btn) btn.setAttribute('aria-label', labels[preference] || 'Toggle theme');
  }

  function setTheme(next) {
    const themeToApply =
      next === 'system' ? (colorSchemeQuery.matches ? 'dark' : 'light') : next;

    root.dataset.colorMode = themeToApply;
    root.dataset.themePreference = next;
    body.classList.remove('dark', 'light');
    body.classList.add(themeToApply);
    wrap?.classList.remove('dark', 'light');
    wrap?.classList.add(themeToApply);

    showThemeIcon(next);
    window.localStorage.setItem('theme', next);

  }

  const initial = typeof window !== 'undefined' ? getInitialTheme() : 'light';
  const stored = typeof window !== 'undefined' ? window.localStorage.getItem('theme') : null;
  const initialPreference =
    stored === 'dark' || stored === 'light' || stored === 'system'
      ? stored
      : initial === 'dark'
        ? 'dark'
        : 'light';

  setTheme(initialPreference);

  btn?.addEventListener('click', () => {
    const current = window.localStorage.getItem('theme') || initialPreference;
    const next =
      current === 'system' ? 'light' : current === 'light' ? 'dark' : 'system';
    setTheme(next);
  });

  colorSchemeQuery.addEventListener('change', () => {
    if (window.localStorage.getItem('theme') === 'system') {
      setTheme('system');
    }
  });
</script>
