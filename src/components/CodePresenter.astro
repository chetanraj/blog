---
import { Code } from 'astro:components';
import { BlogIcon } from './icons/BlogIcon';
import { Clipboard, Check, Play } from '../icons';

interface Props { code: string; lang?: 'js' | 'json'; label?: string; webmcpDemo?: boolean; }
const { code, lang = 'js', label = 'Example', webmcpDemo = false } = Astro.props;
const language = lang === 'json' ? 'JSON' : 'JavaScript';
const tooltipId = `webmcp-tooltip-${crypto.randomUUID()}`;
const source = JSON.stringify(code).replace(/</g, '\\u003c');
---
<figure class="code-presenter" data-code-presenter data-webmcp-demo={webmcpDemo || undefined}>
  <figcaption class="code-presenter-header">
    <span class="code-presenter-title"><span class="code-language">{language}</span></span>
    {webmcpDemo && <>
      <button type="button" class="demo-browser-status" data-demo-status data-state="checking" aria-label="WebMCP status" aria-describedby={tooltipId}><span class="demo-status-label" data-demo-label role="status" aria-live="polite" aria-atomic="true">WebMCP status not checked. JavaScript is required.</span><span id={tooltipId} class="demo-tooltip" data-demo-tooltip role="tooltip">WebMCP status not checked. JavaScript is required.</span></button>
      <button class="presenter-run" data-demo-run type="button" hidden disabled><BlogIcon icon={Play} size="sm" /><span>Run</span></button>
    </>}
    <span class="code-copy-status" data-code-status role="status" aria-live="polite"></span>
    <button class="presenter-copy" data-code-copy type="button" aria-label={`Copy ${language} code`} title="Copy code" hidden>
      <span class="copy-mark"><BlogIcon icon={Clipboard} size="sm" /></span>
      <span class="copied-mark"><BlogIcon icon={Check} size="sm" /></span>
    </button>
  </figcaption>
  <Code code={code} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} tabindex="0" aria-label={`${language}: ${label}`} />
  {webmcpDemo && <section class="demo-output" data-demo-output hidden aria-label="WebMCP demo output">
    <p class="demo-output-label">Output</p>
    <p class="demo-message" data-demo-message role="status" aria-live="polite" aria-atomic="true"></p>
    <pre data-demo-result tabindex="0" aria-label="Actual WebMCP result" hidden></pre>
  </section>}
  <script type="application/json" data-code-source set:html={source} />
</figure>
<script>
  import { initCodePresenters } from '../utils/code-presenter';
  import { initWebMcpDemos } from '../utils/webmcp-demo.js';
  initCodePresenters(document);
  initWebMcpDemos(document);
</script>
<style>
  .code-presenter { min-width:0; max-width:100%; margin:1.5rem 0 2rem; overflow:hidden; border:1px solid var(--trend-border); border-radius:.65rem; background:#fff; }
  .code-presenter-header { position:relative; display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; min-height:3.5rem; padding:.25rem .5rem .25rem 1.25rem; border-bottom:1px solid var(--trend-border); background:var(--trend-surface); color:var(--color-content); font:400 .8125rem/1.5 var(--c-font-body); }
  .demo-browser-status { display:inline-flex; align-items:center; justify-content:center; position:static; flex:0 0 44px; width:44px; height:44px; padding:0; border:0; border-radius:.4rem; background:transparent; cursor:help; --status-dot:#64748b; }
  .demo-browser-status::before { content:''; display:block; width:.65rem; height:.65rem; border:2px solid var(--status-dot); border-radius:50%; background:transparent; }
  .demo-browser-status[data-state='ready'] { --status-dot:#1f7a44; }
  .demo-browser-status:is([data-state='unavailable'],[data-state='failed']) { --status-dot:#b42318; }
  .demo-browser-status:not([data-state='checking'])::before { background:var(--status-dot); }
  :global(html[data-color-mode='dark']) .demo-browser-status { --status-dot:#b2bfc5; }
  :global(html[data-color-mode='dark']) .demo-browser-status[data-state='ready'] { --status-dot:#4ade80; }
  :global(html[data-color-mode='dark']) .demo-browser-status:is([data-state='unavailable'],[data-state='failed']) { --status-dot:#ff8880; }
  .demo-browser-status:focus-visible { outline:2px solid var(--color-accent); outline-offset:-3px; }
  .demo-tooltip { display:none; position:absolute; z-index:2; top:calc(100% - .15rem); right:.75rem; width:max-content; max-width:calc(100% - 1.5rem); box-sizing:border-box; padding:.65rem .8rem; border:1px solid var(--trend-border-accent); border-radius:.4rem; background:var(--bg-color); color:var(--color-content); font:400 .8125rem/1.5 var(--c-font-body); text-align:left; white-space:normal; }
  .demo-browser-status:is(:hover,:focus-visible,[data-tooltip-open='true']) .demo-tooltip { display:block; }
  .demo-browser-status[data-tooltip-dismissed='true'] .demo-tooltip { display:none; }
  .demo-status-label { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .presenter-run { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; min-height:44px; padding:.5rem .75rem; border:1px solid var(--trend-border-accent); border-radius:.4rem; background:transparent; color:var(--color-content); font:inherit; cursor:pointer; }
  .presenter-run:disabled { opacity:.6; cursor:not-allowed; }
  .presenter-run[hidden], .demo-output[hidden], .demo-output pre[hidden] { display:none; }
  .demo-output { border-top:1px solid var(--trend-border); padding:1.25rem; background:var(--trend-surface); color:var(--color-content); }
  .demo-output-label { margin:0 0 .5rem; font:400 .75rem/1.5 var(--studio-tag-font); }
  .demo-message { margin:0 0 .75rem; font-size:.875rem; line-height:1.6; }
  .demo-output pre { max-width:100%; max-height:30rem; overflow:auto; margin:0; padding:1rem; background:var(--bg-color); color:var(--color-content); font:400 14px/1.65 var(--studio-tag-font); white-space:pre; }
  .code-presenter-title { display:flex; flex-wrap:wrap; align-items:center; gap:.35rem .8rem; min-width:0; margin-right:auto; }
  .code-language { font:400 .75rem/1.5 var(--studio-tag-font); color:var(--color-accent); }
  .code-copy-status { font-size:.75rem; line-height:1.4; max-width:14rem; }
  .presenter-copy { display:grid; place-items:center; flex:0 0 44px; width:44px; height:44px; border:1px solid transparent; border-radius:.4rem; background:transparent; color:var(--color-content); cursor:pointer; }
  .presenter-copy[hidden] { display:none; }
  .presenter-copy:hover { border-color:var(--trend-border-accent); }
  .presenter-copy:focus-visible { outline:2px solid var(--color-accent); outline-offset:-3px; }
  .presenter-copy:disabled { cursor:wait; }
  .copied-mark, .presenter-copy[data-copied='true'] .copy-mark { display:none; }
  .presenter-copy[data-copied='true'] .copied-mark { display:block; }
  .code-presenter :global(pre.astro-code) { box-sizing:border-box; width:100%; max-width:100%; margin:0; padding:1.25rem 1.25rem 2rem; border:0; border-radius:0; box-shadow:none; overflow-x:auto; white-space:pre; tab-size:2; background:var(--shiki-light-bg); color:var(--shiki-light); }
  .code-presenter :global(pre.astro-code), .code-presenter :global(pre.astro-code code), .code-presenter :global(pre.astro-code span) { font-family:var(--studio-tag-font); font-size:14px; font-weight:400; font-style:normal; line-height:1.65; letter-spacing:0; }
  .code-presenter :global(pre.astro-code:focus-visible) { outline:2px solid var(--color-accent); outline-offset:-3px; }
  .code-presenter :global(pre.astro-code code) { display:block; width:max-content; min-width:100%; background:none; padding:0; border:0; color:inherit; }
  .code-presenter :global(pre.astro-code span) { color:var(--shiki-light); }
  :global(html[data-color-mode='dark']) .code-presenter { background:#24292e; }
  :global(html[data-color-mode='dark']) .code-presenter :global(pre.astro-code) { background:var(--shiki-dark-bg); color:var(--shiki-dark); }
  :global(html[data-color-mode='dark']) .code-presenter :global(pre.astro-code span) { color:var(--shiki-dark); }
  @media(min-width:768px) { .code-presenter :global(pre.astro-code), .code-presenter :global(pre.astro-code code), .code-presenter :global(pre.astro-code span) { font-size:15px; } }
  @media(max-width:480px) { .code-presenter-header { padding-left:1rem; } .code-presenter :global(pre.astro-code) { padding:1rem 1rem 2rem; } .code-copy-status { max-width:8rem; } }
</style>
