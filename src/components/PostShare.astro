---
import { BlogIcon } from './icons/BlogIcon';
import { Check, Clipboard, Linkedin, Share2, X } from '../icons';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="post-share" data-post-share data-share-title={title}>
  <p class="post-share-label">Share</p>
  <div class="post-share-actions">
    <button type="button" class="post-share-btn" data-native-share hidden aria-label="Share using your device" title="Share using your device">
      <BlogIcon icon={Share2} size="md" />
    </button>
    <button type="button" class="post-share-btn" data-copy-url={url} hidden aria-label="Copy link" title="Copy link">
      <span class="post-share-icon post-share-icon--copy">
        <BlogIcon icon={Clipboard} size="md" />
      </span>
      <span class="post-share-icon post-share-icon--check">
        <BlogIcon icon={Check} size="md" />
      </span>
    </button>
    <a
      class="post-share-btn"
      href={`https://x.com/intent/post?url=${encodedUrl}&text=${encodedTitle}`}
      rel="noopener noreferrer"
      target="_blank"
      aria-label="Share on X (opens website)" title="Share on X (opens website)"
    >
      <BlogIcon icon={X} size="md" />
    </a>
    <a
      class="post-share-btn"
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
      rel="noopener noreferrer"
      target="_blank"
      aria-label="Share on LinkedIn (opens website)" title="Share on LinkedIn (opens website)"
    >
      <BlogIcon icon={Linkedin} size="md" />
    </a>
  </div>
  <p class="post-share-status" data-share-status role="status" aria-live="polite" aria-atomic="true"></p>
  <label class="post-share-manual" data-manual-copy hidden>
    Article link
    <input type="text" readonly value={url} aria-label="Article link to copy" />
  </label>
</div>

<script>
  import { initPostShare } from '../utils/post-share';
  const bind = () => document.querySelectorAll<HTMLElement>('[data-post-share]').forEach(initPostShare);
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .post-share { flex-wrap:wrap; min-width:0; }
  .post-share :is(button, a).post-share-btn { color:var(--color-content); background:var(--bg-color); width:44px; height:44px; text-decoration:none; }
  .post-share :is(button, a).post-share-btn:is(:hover, :focus-visible) { color:var(--color-accent); border-color:var(--color-accent); }
  .post-share :is(button, a).post-share-btn:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  .post-share [hidden] { display:none!important; }
  .post-share-status { flex-basis:100%; margin:0; font-size:.8125rem; line-height:1.5; }
  .post-share-status:empty { display:none; }
  .post-share-manual { display:block; flex-basis:100%; min-width:0; font-size:.8125rem; }
  .post-share-manual input { display:block; width:100%; min-width:0; box-sizing:border-box; margin-top:.5rem; padding:.65rem; font:inherit; color:var(--color-content); background:var(--bg-color); border:1px solid var(--trend-border); border-radius:.4rem; }
</style>
