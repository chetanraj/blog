---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import * as stylex from '@stylexjs/stylex';
import { indexStyles } from '../styles/index.stylex';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const posts = (await getCollection('posts'))
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [latestPost, ...otherPosts] = posts;
---

<BaseLayout title="Hi 👋 | Blog by Chetan Raj">
  <div {...stylex.props(indexStyles.sectionHeading)}>
    Latest post
  </div>

  {
    latestPost &&
      (() => {
        const daysSince = Math.floor(
          (Date.now() - latestPost.data.date.getTime()) / (1000 * 60 * 60 * 24)
        );
        const isNew = daysSince < 35;
        return (
          <a {...stylex.props(indexStyles.postLink)} href={`${base}posts/${latestPost.slug}/`}>
            <div {...stylex.props(indexStyles.postTitle)}>
              {latestPost.data.title}
            </div>
            <div {...stylex.props(indexStyles.postDescription)}>
              {latestPost.data.description}
            </div>
            <div {...stylex.props(indexStyles.postMeta)}>
              wrote on {latestPost.data.date.toISOString().slice(0, 10)}
              {isNew ? (
                <span {...stylex.props(indexStyles.newBadgeWrap)}>
                  &#183;&nbsp;
                  <span class:list={['new', stylex.props(indexStyles.newBadge).className]}>
                    New
                  </span>
                </span>
              ) : (
                ''
              )}
            </div>
          </a>
        );
      })()
  }

  <div {...stylex.props(indexStyles.sectionHeading)}>
    Other posts
  </div>

  <ul {...stylex.props(indexStyles.postList)}>
    {
      otherPosts.map((post) =>
        (() => {
          const daysSince = Math.floor(
            (Date.now() - post.data.date.getTime()) / (1000 * 60 * 60 * 24)
          );
          const isNew = daysSince < 35;
          return (
            <li {...stylex.props(indexStyles.postListItem)}>
              <a {...stylex.props(indexStyles.postLink)} href={`${base}posts/${post.slug}/`}>
                <div {...stylex.props(indexStyles.postTitle)}>
                  {post.data.title}
                </div>
                <div {...stylex.props(indexStyles.postDescription)}>
                  {post.data.description}
                </div>
                <div {...stylex.props(indexStyles.postMeta)}>
                  wrote on {post.data.date.toISOString().slice(0, 10)}
                  {isNew ? (
                    <span {...stylex.props(indexStyles.newBadgeWrap)}>
                      &#183;&nbsp;
                      <span class:list={['new', stylex.props(indexStyles.newBadge).className]}>
                        New
                      </span>
                    </span>
                  ) : (
                    ''
                  )}
                </div>
              </a>
            </li>
          );
        })()
      )
    }
  </ul>
</BaseLayout>
