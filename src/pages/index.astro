---
import { BlogIcon } from '../components/icons/BlogIcon';
import { ArrowUpRight } from '../icons';
import { Inline, Link, Stack, Text } from '@capper-ui/react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, getPostCategory } from '../utils/categories';
import { SITE } from '../site.config';
import { formatDate } from '../utils/date';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const posts = (await getCollection('posts')).filter(post => post.data.published !== false).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const [latest, ...others] = posts;
const topics = categories;
---
<BaseLayout title={`Notes from the build | ${SITE.title}`} description={SITE.description} path="/">
  <section id="writing" class="studio-writing" aria-label="Writing">
    <div class="notebook-heading"><Text as="h2" weight="bold">The notebook</Text><Link href={`${base}tags/`}>Browse categories <span class="inline-arrow"><BlogIcon icon={ArrowUpRight} size="sm" /></span></Link></div>
    <div class="notebook-filters" role="group" aria-label="Filter notes by category"><button type="button" data-topic-reset aria-pressed="true" aria-controls="note-results">All</button>{topics.map(topic => <button type="button" data-topic={topic} aria-pressed="false" aria-controls="note-results">{topic}</button>)}</div>
    <p class="filter-results" role="status" aria-live="polite" aria-atomic="true">{posts.length} note{posts.length === 1 ? '' : 's'}</p>
    <div id="note-results">
    {latest && <article class="featured-note" data-note data-topics={JSON.stringify([getPostCategory(latest)])}>
      <Inline gap="md" align="center" className="note-topline"><span class="eyebrow latest-note-label">01 • Latest</span><time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time></Inline>
      <Text as="h2" weight="bold"><Link href={`${base}posts/${latest.id}/`}>{latest.data.title}</Link></Text>
      {latest.data.description && <p class="featured-description">{latest.data.description}</p>}
      <div class="note-bottomline"><span class="note-topics">{getPostCategory(latest)}</span><Link href={`${base}posts/${latest.id}/`}>Read the note <span class="inline-arrow"><BlogIcon icon={ArrowUpRight} size="sm" /></span></Link></div>
    </article>}
    <Stack as="ul" gap="none" className="notebook-list">{others.map(post => <li data-note data-topics={JSON.stringify([getPostCategory(post)])}><article class="notebook-row"><div class="notebook-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{getPostCategory(post)}</span></div><Text as="h3" weight="bold"><Link href={`${base}posts/${post.id}/`}>{post.data.title}<span class="link-arrow" aria-hidden="true"><BlogIcon icon={ArrowUpRight} size="md" /></span></Link></Text></article></li>)}</Stack>
    <p class="filter-empty" hidden>No notes match this category. Choose All to reset.</p>
    </div>
    <nav class="notebook-ending" aria-label="Explore more">
      <p class="ending-label">Keep exploring</p>
      <div class="ending-links">
        <a href={`${base}tags/`}><span>Browse categories</span><small>Five ways into the archive</small><span class="link-arrow" aria-hidden="true"><BlogIcon icon={ArrowUpRight} size="md" /></span></a>
        <a href={`${base}about/`}><span>About Chetan</span><small>The person behind the notes</small><span class="link-arrow" aria-hidden="true"><BlogIcon icon={ArrowUpRight} size="md" /></span></a>
      </div>
    </nav>
  </section>
</BaseLayout>
<script>
  import { initTopicFilters } from '../utils/topic-filter';
  const writing = document.querySelector<HTMLElement>('#writing');
  if (writing) initTopicFilters(writing, { single: true });
</script>


<style>
  .link-arrow { display:flex; flex-shrink:0; align-self:center; }
  .inline-arrow { display:inline-flex; vertical-align:-.15em; margin-left:.15em; }
  :global(#main:has(.studio-writing)) { min-height:0; }
  .studio-writing { padding-bottom:1.25rem; }
  .notebook-ending { margin-top:1.75rem; padding-top:1.25rem; border-top:1px solid var(--trend-border); color:var(--color-content); }
  .ending-label { margin:0 0 .65rem; font: .65rem var(--studio-tag-font); text-transform:uppercase; letter-spacing:.1em; color:var(--color-secondary); }
  .ending-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .ending-links a { display:grid; grid-template-columns:1fr auto; align-items:center; gap:.2rem .75rem; padding:.75rem 0; min-height:44px; color:var(--color-content); text-decoration:none; }
  .ending-links a>span:first-child { font-weight:600; }
  .ending-links small { grid-column:1; font-size:.8rem; color:var(--color-secondary); }
  .ending-links a>span:last-child { grid-column:2; grid-row:1/3; color:var(--color-accent); }
  .ending-links a:hover>span:first-child { text-decoration:underline; text-underline-offset:.2em; }
  .ending-links a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; border-radius:.25rem; }
  @media(max-width:480px) { .ending-links { grid-template-columns:1fr; gap:.25rem; } }
</style>
