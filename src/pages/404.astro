---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Inline, Link, Stack, Text } from '@capper-ui/react';
import { SITE } from '../site.config';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`404 - Not Found | ${SITE.title}`}
  description="The page you are looking for could not be found."
  path="/404/"
>
  <div class="blog-post-container">
    <div class="blog-post-content static-page">
      <Stack gap="md">
        <Text as="h1" size="4xl" weight="bold">
          Page not found
        </Text>
        <Text as="p">This page doesn’t exist, or it may have moved.</Text>
        <Inline gap="sm" align="center">
          <Link href={base}>Back to the blog</Link>
          <Text as="span" color="muted">
            ·
          </Text>
          <Link href={`${base}search/`}>Search posts</Link>
        </Inline>
      </Stack>
    </div>
  </div>
</BaseLayout>
