---
import { BlogIcon } from '../components/icons/BlogIcon';
import { Instagram } from '../icons';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Link, Stack, Text } from '@capper-ui/react';
import { SITE } from '../site.config';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`About | ${SITE.title}`}
  headerTitle="About"
  description="About Chetan Raj — web designer, developer, and writer behind this blog and JavaScript Essentials."
  path="/about/"
>
  <article class="blog-post-container">
    <div class="blog-post-content static-page about-page">
      <Stack gap="md">
        <Text as="p">
          I'm <strong>{SITE.author.name}</strong> — a web designer and developer based in Bangalore.
          I write about JavaScript, React, CSS, Node.js, and the small details that make developer
          tools pleasant to use.
        </Text>
        <Text as="p">
          This blog is my long-form home for tutorials, notes, and opinions. Shorter snapshots and
          code snippets live on{' '}
          <Link
            href="https://www.instagram.com/javascriptessentials/"
            className="inline-social-link"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="inline-social-leading"><span class="inline-social-icon" aria-hidden="true"><BlogIcon icon={Instagram} size="sm" /></span>{' '}JavaScript</span>{' '}Essentials
          </Link>
          .
        </Text>
        <Text as="p">
          When I'm not coding, you'll find me chasing music, movies, gadgets, and the occasional
          debate about Iron Man vs Batman.
        </Text>
        <Text as="p">
          <Link href={base}>← Back to all posts</Link>
        </Text>
      </Stack>
    </div>
  </article>
</BaseLayout>


<style>
  /* Capper Text has its own color; keep this page on the active theme tokens. */
  .about-page :global(p) { color: var(--color-content); }
  .about-page :global(a) { color: var(--color-accent); }
  .about-page :global(.inline-social-link) { font:inherit; }
  .inline-social-leading { white-space:nowrap; }
  .inline-social-icon { display:inline-block; width:1em; height:1em; vertical-align:-.15em; }
  .inline-social-icon :global(svg) { width:1em; height:1em; }
</style>
