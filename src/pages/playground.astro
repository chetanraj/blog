---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignEraPicker from '../components/DesignEraPicker.astro';
import { Link, Stack, Text } from '@capper-ui/react';
import { SITE } from '../site.config';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`Playground | ${SITE.title}`}
  headerTitle="Playground"
  description="Try different design eras on the blog — from flat Material to liquid glass and brutalism."
  path="/playground/"
>
  <article class="blog-post-container">
    <div class="blog-post-content static-page">
      <Stack gap="md">
        <Text as="p">
          Pick a design era below and the whole blog restyles. Your choice is saved in the browser
          and applies on every page until you change it again.
        </Text>
        <Text as="p" color="muted" size="sm">
          Use the theme toggle in the header for light, dark, or system mode. Design era and color
          mode work together.
        </Text>

        <DesignEraPicker />

        <Text as="p">
          <Link href={base}>← Back to all posts</Link>
        </Text>
      </Stack>
    </div>
  </article>
</BaseLayout>
