---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Badge, Inline, Link, Stack, Text } from '@capper-ui/react';
import { getCollection } from 'astro:content';
import { getAllTags, tagToSlug } from '../../utils/tags';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const posts = (await getCollection('posts')).filter((post) => post.data.published !== false);
const tags = getAllTags(posts);
---

<BaseLayout
  title="Tags | Blog by Chetan Raj"
  headerTitle="Tags"
  description="Browse posts by topic — JavaScript, React, CSS, Node.js, and more."
  path="/tags/"
>
  <div class="blog-post-container">
    <div class="blog-post-content static-page">
      <Text as="p" color="muted">Browse posts by topic.</Text>
      <Inline as="ul" gap="sm" wrap className="tag-cloud">
        {
          tags.map((tag) => (
            <li>
              <Link href={`${base}tags/${tagToSlug(tag)}/`} className="tag-pill-link">
                <Badge variant="accent" size="sm">
                  {tag}
                </Badge>
              </Link>
            </li>
          ))
        }
      </Inline>
      <Text as="p">
        <Link href={base}>← Back to all posts</Link>
      </Text>
    </div>
  </div>
</BaseLayout>
