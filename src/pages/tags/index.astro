---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Badge, Inline, Link, Text } from '@capper-ui/react';
import { categories } from '../../utils/categories';
import { tagToSlug } from '../../utils/tags';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const tags = categories;
---

<BaseLayout
  title="Categories | Blog by Chetan Raj"
  headerTitle="Categories"
  description="Browse JavaScript, React, CSS & Styling, Tools & Workflow, and Deployment."
  path="/tags/"
>
  <div class="blog-post-container">
    <div class="blog-post-content static-page">
      <Text as="p" color="muted">Five categories. Find what you want to build.</Text>
      <Inline as="ul" gap="sm" wrap className="tag-cloud">
        {
          tags.map((tag) => (
            <li>
              <Link href={`${base}tags/${tagToSlug(tag)}/`} className="tag-pill-link">
                <Badge variant="accent" size="sm" className="topic-label">
                  {tag}
                </Badge>
              </Link>
            </li>
          ))
        }
      </Inline>
      <Text as="p">
        <Link href={base}>← Back to all posts</Link>
      </Text>
    </div>
  </div>
</BaseLayout>
