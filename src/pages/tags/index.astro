---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAllTags, tagToSlug } from '../../utils/tags';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const posts = (await getCollection('posts')).filter((post) => post.data.published !== false);
const tags = getAllTags(posts);
---

<BaseLayout
  title="Tags | Blog by Chetan Raj"
  headerTitle="Tags"
  description="Browse posts by topic — JavaScript, React, CSS, Node.js, and more."
  path="/tags/"
>
  <div class="blog-post-container">
    <div class="blog-post-content static-page">
      <p class="text-blog-secondary">Browse posts by topic.</p>
      <ul class="tag-cloud">
        {
          tags.map((tag) => (
            <li>
              <a class="tag-pill" href={`${base}tags/${tagToSlug(tag)}/`}>
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
      <p>
        <a href={base}>← Back to all posts</a>
      </p>
    </div>
  </div>
</BaseLayout>
