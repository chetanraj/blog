---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Link, Stack, Text } from '@capper-ui/react';
import { getCollection } from 'astro:content';
import { categories, categoryForTag, getPostCategory } from '../../utils/categories';
import { tagToSlug } from '../../utils/tags';
import { formatDate } from '../../utils/date';

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((post) => post.data.published !== false);
  const routes = new Map(categories.map(category => [tagToSlug(category), category]));
  // Keep every old inbound tag URL; normalize duplicates such as React/react.
  for (const post of posts) for (const tag of post.data.tags ?? []) {
    const slug = tagToSlug(tag);
    if (!routes.has(slug)) routes.set(slug, categoryForTag(tag) ?? getPostCategory(post));
  }
  return [...routes].map(([slug, tag]) => ({ params: { tag: slug }, props: { tag } }));
}

const { tag } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allPosts = (await getCollection('posts')).filter((post) => post.data.published !== false);
const resolvedTag = tag;
const posts = allPosts.filter(post => getPostCategory(post) === resolvedTag).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title={`${resolvedTag} | Blog by Chetan Raj`}
  headerTitle={resolvedTag}
  description={`Posts about ${resolvedTag}.`}
  path={`/tags/${Astro.params.tag}/`}
>
  <div class="blog-post-container">
    <div class="blog-post-content static-page">
      <Text as="p" color="muted">
        {posts.length} post{posts.length === 1 ? '' : 's'}
      </Text>
      <Stack as="ul" gap="md" className="archive-list">
        {
          posts.map((post) => (
            <li>
              <Link href={`${base}posts/${post.id}/`} className="archive-link">
                <Stack gap="xs">
                  <Text as="span" weight="semibold" className="archive-title">
                    {post.data.title}
                  </Text>
                  <Text as="span" size="sm" color="subtle" className="archive-date">
                    {formatDate(post.data.date)}
                  </Text>
                </Stack>
              </Link>
            </li>
          ))
        }
      </Stack>
      <Text as="p">
        <Link href={`${base}tags/`}>← All categories</Link>
      </Text>
    </div>
  </div>
</BaseLayout>
