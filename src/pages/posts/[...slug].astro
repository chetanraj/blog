---
import AsciiOcean from '../../components/AsciiOcean.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PostShare from '../../components/PostShare.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import CodeCopyButtons from '../../components/CodeCopyButtons.astro';
import { Badge, Inline, Link } from '@capper-ui/react';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { absoluteUrl } from '../../site.config';
import { getAdjacentPosts } from '../../utils/posts';
import { getPostCategory } from '../../utils/categories';
import { tagToSlug } from '../../utils/tags';
import { formatDate } from '../../utils/date';
import * as stylex from '@stylexjs/stylex';
import { utilityStyles } from '../../styles/utilities.stylex';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const showToc = post.data.toc;
const tocDepth = post.data.tocDepth;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allPublished = (await getCollection('posts')).filter(
  (entry) => entry.data.published !== false
);
const { previous: previousPost, next: nextPost } = getAdjacentPosts(
  post,
  allPublished
);
const postUrl = absoluteUrl(`/posts/${post.id}/`);
const modifiedTime = post.data.updated?.toISOString();
const publishedTime = post.data.date.toISOString();
const showUpdated =
  post.data.updated && post.data.updated.getTime() > post.data.date.getTime();
---

<BaseLayout
  title={post.data.title}
  headerTitle={post.data.title}
  postCoverId={post.id}
  description={post.data.description}
  path={`/posts/${post.id}/`}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  showScrollProgress
>
  <article class="blog-post-container">
    <div class="post-layout">
      <div class="post-layout-main">
        <div class="blog-post-content">
          <Inline gap="md" wrap align="center" className="post-meta">
            <time datetime={publishedTime} class="post-meta-item">
              {formatDate(post.data.date)}
            </time>

            {
              showUpdated && post.data.updated && (
                <span class="post-meta-item post-meta-updated">
                  updated {formatDate(post.data.updated)}
                </span>
              )
            }

            <span class="post-meta-item">
              {remarkPluginFrontmatter.minutesRead}
            </span>

            {
              getPostCategory(post) && (
                <Inline gap="sm" wrap className="post-meta-item post-meta-tags">
                  {[getPostCategory(post)].map((tag) => (
                    <Link href={`${base}tags/${tagToSlug(tag)}/`} className="post-tag-link">
                      <Badge variant="accent" size="sm" className="topic-label">
                        {tag}
                      </Badge>
                    </Link>
                  ))}
                </Inline>
              )
            }
          </Inline>

          {
            showToc && (
              <TableOfContents headings={headings} maxDepth={tocDepth} />
            )
          }

          <div class:list={['blog-post-body', stylex.props(utilityStyles.textPrimary).className]}>
            <Content />
          </div>

          <div class="post-end-actions">
            <PostShare title={post.data.title} url={postUrl} />
          </div>
          <RelatedPosts previous={previousPost} next={nextPost} base={base} />
        </div>
      </div>
    </div>
  </article>
  <AsciiOcean />
  <CodeCopyButtons />
</BaseLayout>
