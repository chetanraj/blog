---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import * as stylex from '@stylexjs/stylex';
import { postStyles } from '../../styles/post.stylex';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { Content, remarkPluginFrontmatter } = await render(post);
---

<BaseLayout title={post.data.title} headerTitle={post.data.title}>
  <article class="blog-post-container">
    <div class="blog-post-content">
      <div {...stylex.props(postStyles.metaRow)}>
        <time
          datetime={post.data.date.toISOString()}
          {...stylex.props(postStyles.metaItem)}
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            {...stylex.props(postStyles.metaIcon)}
            ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
              x1="16"
              y1="2"
              x2="16"
              y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
              x1="3"
              y1="10"
              x2="21"
              y2="10"></line></svg
          >
          {post.data.date.toISOString().slice(0, 10)}
        </time>

        <div {...stylex.props(postStyles.metaItem)}>
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            {...stylex.props(postStyles.metaIcon)}
            ><circle cx="12" cy="12" r="10"></circle><polyline
              points="12 6 12 12 16 14"></polyline></svg
          >
          {remarkPluginFrontmatter.minutesRead}
        </div>

        <div {...stylex.props(postStyles.metaItem)}>
          {
            post.data.tags && post.data.tags.length > 0 && (
              <div {...stylex.props(postStyles.tagList)}>
                {post.data.tags.map((tag) => (
                  <span {...stylex.props(postStyles.tag)}>
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </div>

      <div {...stylex.props(postStyles.content)}>
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
