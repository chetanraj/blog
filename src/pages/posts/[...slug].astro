---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import AuthorBlurb from '../../components/AuthorBlurb.astro';
import PostShare from '../../components/PostShare.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import CodeCopyButtons from '../../components/CodeCopyButtons.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { absoluteUrl } from '../../site.config';
import { getRelatedPosts } from '../../utils/posts';
import { tagToSlug } from '../../utils/tags';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const showToc = post.data.toc;
const tocDepth = post.data.tocDepth;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allPublished = (await getCollection('posts')).filter(
  (entry) => entry.data.published !== false
);
const relatedPosts = getRelatedPosts(post, allPublished);
const postUrl = absoluteUrl(`/posts/${post.slug}/`);
const modifiedTime = post.data.updated?.toISOString();
const publishedTime = post.data.date.toISOString();
const showUpdated =
  post.data.updated && post.data.updated.getTime() > post.data.date.getTime();
---

<BaseLayout
  title={post.data.title}
  headerTitle={post.data.title}
  description={post.data.description}
  path={`/posts/${post.slug}/`}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  showScrollProgress
>
  <article class="blog-post-container">
    <div class="post-layout">
      {
        showToc && (
          <aside class="post-toc-aside" aria-label="Table of contents sidebar">
            <TableOfContents headings={headings} maxDepth={tocDepth} variant="sticky" />
          </aside>
        )
      }

      <div class="post-layout-main">
        <div class="blog-post-content">
          <div
            class="post-meta mt-4 mb-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-blog-secondary"
          >
            <time datetime={publishedTime} class="flex items-center justify-center">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-1"
                ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
                  x1="16"
                  y1="2"
                  x2="16"
                  y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
                  x1="3"
                  y1="10"
                  x2="21"
                  y2="10"></line></svg
              >
              {post.data.date.toISOString().slice(0, 10)}
            </time>

            {
              showUpdated && post.data.updated && (
                <span class="flex items-center justify-center text-sm">
                  updated {post.data.updated.toISOString().slice(0, 10)}
                </span>
              )
            }

            <div class="flex items-center justify-center">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-1"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
              {remarkPluginFrontmatter.minutesRead}
            </div>

            <div class="flex items-center justify-center">
              {
                post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex gap-2 flex-wrap">
                    {post.data.tags.map((tag) => (
                      <a
                        href={`${base}tags/${tagToSlug(tag)}/`}
                        class="tag-pill post-tag"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                )
              }
            </div>
          </div>

          {
            showToc && (
              <div class="post-toc-mobile">
                <TableOfContents headings={headings} maxDepth={tocDepth} variant="inline" />
              </div>
            )
          }

          <div class="text-blog-primary blog-post-body">
            <Content />
          </div>

          <PostShare title={post.data.title} url={postUrl} />
          <AuthorBlurb />
          <RelatedPosts posts={relatedPosts} base={base} />
        </div>
      </div>
    </div>
  </article>
  <CodeCopyButtons />
</BaseLayout>
